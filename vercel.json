{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/router.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/router?route=health"
    },
    {
      "source": "/api/cron/newsroom",
      "destination": "/api/router?route=cron/newsroom"
    },
    {
      "source": "/api/content/today",
      "destination": "/api/router?route=content/today"
    },
    {
      "source": "/api/content/archive",
      "destination": "/api/router?route=content/archive"
    },
    {
      "source": "/api/admin/status",
      "destination": "/api/router?route=admin/status"
    },
    {
      "source": "/api/admin/review",
      "destination": "/api/router?route=admin/review"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/newsroom",
      "schedule": "* * * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/realistic-scenes-final.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/vignette-(.*).jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
